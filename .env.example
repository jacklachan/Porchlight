# Copy to .env and fill in. Everything is optional: with nothing set,
# `python -m porchlight --demo` runs against the bundled local stand-in.

# --- Ring Partner API (pick ONE sign-in) -------------------------------------
# 1) Access token from the Ring Developer Playground (lasts about 30 minutes).
#    https://developer.amazon.com/ring/console/playground  ->  Generate Token
#    You can also paste a fresh one in the dashboard (the Ring pill, top right).
# RING_ACCESS_TOKEN=
# 2) OAuth refresh token for a registered Ring app (auto-renewing).
# RING_REFRESH_TOKEN=
# RING_CLIENT_ID=
# RING_CLIENT_SECRET=

# HMAC signing key issued with your Ring partner credentials. Needed only to
# receive webhooks at POST /webhooks/ring. Without it, Porchlight polls Event History.
# RING_HMAC_SIGNING_KEY=

# Optional: pin one device. By default the first doorbell on the account is used.
# RING_DEVICE_ID=

# --- Reading frames ------------------------------------------------------------
# none     no model; every frame is held for a family member to confirm (default)
# bedrock  Amazon Bedrock Converse API (needs AWS credentials and `pip install -e ".[aws]"`)
# openai   any OpenAI-compatible chat completions endpoint with image input
# fixture  only understands frames drawn by the local stand-in
VISION_PROVIDER=none
# For VISION_PROVIDER=openai (a hosted API, or a local server such as Ollama):
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_API_KEY=
# VISION_MODEL=gpt-4o-mini
# BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# AWS_REGION=us-east-1
# Readings below this confidence are held for a person instead of acting.
# CONFIDENCE_THRESHOLD=0.75

# --- The assistant page (/alexa) -------------------------------------------------
# rules    keyword router, no model needed (default)
# bedrock  a Bedrock model chooses which MCP tools to call
ASSISTANT_PROVIDER=rules
# ASSISTANT_MODEL_ID=us.amazon.nova-lite-v1:0

# --- Household -------------------------------------------------------------------
PORCHLIGHT_PERSON_NAME=Mom
PORCHLIGHT_TIMEZONE=Asia/Kolkata
# How long a package may sit before the family is told, when a check-in does not say.
# DEFAULT_COLLECT_WITHIN_MINUTES=180
# EARLY_GRACE_MINUTES=30
# LATE_GRACE_MINUTES=60
# POLL_SECONDS=20
# PORCH_CHECK_MINUTES=15

# POSTed a small JSON body for every attention/urgent alert and approved action.
# NOTIFY_WEBHOOK_URL=

# --- Serving ---------------------------------------------------------------------
# PORCHLIGHT_HOST=127.0.0.1
# PORCHLIGHT_PORT=8000
# PORCHLIGHT_DATA_DIR=data
# Set when hosted, so the MCP endpoint accepts requests for this hostname.
# PUBLIC_BASE_URL=https://your-app.example.com
# Require `Authorization: Bearer ...` on /mcp and on the dashboard API.
# MCP_AUTH_TOKEN=
# PORCHLIGHT_API_TOKEN=
